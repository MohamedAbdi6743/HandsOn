# Copy this file to .env and fill in your own values.
# .env is ignored by Git, so your real values never get committed.
# Both Docker Compose and the Spring Boot app read it.

# If port 5440 is taken on your machine, change it in both lines below.
DB_PORT=5440
DB_URL=jdbc:postgresql://localhost:5440/handson
DB_USERNAME=handson
DB_PASSWORD=choose-a-local-password

# Port the app runs on. Change it if 8080 is already used on your machine.
APP_PORT=8080

# The first coordinator account, created when the app starts (password: at least 10 characters).
HANDSON_ADMIN_EMAIL=coordinator@handson.test
HANDSON_ADMIN_PASSWORD=choose-a-coordinator-password
